    {
      "id": 7,
      "title": "Submits by outcome (per min)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(futu_oms_submits_total[5m])) * 60",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Risk rejects by reason (per min)",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
