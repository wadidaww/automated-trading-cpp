          "legendFormat": "live orders",
          "refId": "A"
        },
        {
          "expr": "futu_rate_limit_utilization",
          "legendFormat": "rate utilization",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Quotes per second",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rate(futu_engine_quotes_received_total[1m])",
          "legendFormat": "received",
          "refId": "A"
        },
        {
          "expr": "rate(futu_engine_quotes_processed_total[1m])",
          "legendFormat": "processed",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "Quotes lost (per min)",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 11,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rate(futu_engine_quotes_dropped_total[5m]) * 60",
          "legendFormat": "dropped (ring full)",
          "refId": "A"
        },
        {
          "expr": "rate(futu_engine_quotes_stale_skipped_total[5m]) * 60",
          "legendFormat": "stale skipped",
          "refId": "B"
        },
        {
          "expr": "rate(futu_quote_decode_errors_total[5m]) * 60",
          "legendFormat": "decode errors",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 12,
      "title": "Handle latency (p50 / p99 / p99.9)",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 11,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(futu_engine_handle_seconds_bucket[1m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(futu_engine_handle_seconds_bucket[1m])))",
          "legendFormat": "p99",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.999, sum by (le) (rate(futu_engine_handle_seconds_bucket[1m])))",
          "legendFormat": "p99.9",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
